<resources>
    <color name="screen_bg">#121A18</color>
    <style name="Base.Theme.Task_1"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">#3E8E7E</item>
        <item name="colorSecondary">#3E8E7E</item>

        <item name="android:windowBackground">#121A18</item>
        <item name="android:statusBarColor">#0B1210</item>
        <item name="android:navigationBarColor">#121A18</item>
     </style>
        <style name="Edittext" parent="Base.Theme.Task_1">
            <item name="android:layout_height">48dp</item>
            <item name="android:layout_width">match_parent</item>
            <item name="android:textColor">@color/white</item>
            <item name="android:drawablePadding">12dp</item>
            <item name="android:paddingStart">12dp</item>
            <item name="android:textSize">20sp</item>
            <item name="android:layout_marginTop">20dp</item>
            <item name="android:textColorHint">@color/black</item>
        </style>

        <style name="icon" parent="Base.Theme.Task_1">
            <item name="android:layout_height">100dp</item>
            <item name="android:layout_width">100dp</item>
            <item name="android:tint">#3E8E7E</item>
            <item name="android:padding">15dp</item>

        </style>

        <style name="textview1" parent="Base.Theme.Task_1">
            <item name="android:layout_height">wrap_content</item>
            <item name="android:layout_width">wrap_content</item>
            <item name="android:textColor">@color/white</item>
            <item name="android:textStyle">bold</item>
            <item name="android:textSize">28sp</item>
            <item name="android:layout_marginTop">20dp</item>

        </style>

        <style name="textview2" parent="Base.Theme.Task_1">
            <item name="android:layout_height">wrap_content</item>
            <item name="android:layout_width">wrap_content</item>
            <item name="android:textColor">@color/white</item>
            <item name="android:textSize">20sp</item>
            <item name="android:layout_marginTop">6dp</item>
        </style>

        <style name="textview3" parent="Base.Theme.Task_1">
            <item name="android:layout_height">wrap_content</item>
            <item name="android:layout_width">wrap_content</item>
            <item name="android:textColor">#4DB6AC</item>
            <item name="android:textSize">15sp</item>
            <item name="android:textStyle">bold</item>
            <item name="android:layout_marginTop">10dp</item>
        </style>

        <style name="Button" parent="Base.Theme.Task_1">
            <item name="android:layout_height">55dp</item>
            <item name="android:layout_width">match_parent</item>
            <item name="android:textColor">@color/black</item>
            <item name="android:textSize">16sp</item>
            <item name="android:textStyle">bold</item>
            <item name="android:layout_marginTop">28dp</item>
        </style>

</resources>
